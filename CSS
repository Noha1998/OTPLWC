.container { 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    min-height: 5vh; 
} 
  
.input { 
    width: 45px; 
    border: none; 
    border-bottom: 3px solid rgba(0, 0, 0, 0.5); 
    margin: 0 10px; 
    text-align: center; 
    font-size: 30px; 
} 
  
.input:focus { 
    border-bottom: 3px solid rgb(0, 95, 106); ; 
    outline: none; 
} 
  
.input:nth-child(1) { 
    cursor: pointer; 
    pointer-events: all; 
}
