public class GenerateOTP {
    
    @InvocableMethod
    public static List<OTPResult> generateOTP() {
        
        String generatedOTP = generateOTPLogic();

        // Create a result list
        List<OTPResult> results = new List<OTPResult>();

        // Create a result object and set the generated OTP
        OTPResult result = new OTPResult();
        result.generatedOTP = generatedOTP;

        // Add the result to the list
        results.add(result);
        
